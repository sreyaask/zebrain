# Zebrain environment. Copy to .env.local and fill in. Never commit real values.

# Supabase (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase secret/service key: server only. Payments, wallets, trials, token budgets.
SUPABASE_SERVICE_ROLE_KEY=

# Encrypts users' saved Kaggle and Hugging Face tokens (AES-256-GCM). Required in production. openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Zebrain AI (Alibaba Model Studio, Singapore). Set a monthly budget with "Stop Service When Budget Reached".
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen3.7-flash
# QWEN_PRICE_IN=0.03    # USD per 1M input tokens, for spend tracking
# QWEN_PRICE_OUT=0.13   # USD per 1M output tokens

# Razorpay (use test keys rzp_test_... until live checks pass)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret from Razorpay Dashboard → Webhooks (events: payment.captured, order.paid) → /api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Rupees per US dollar for buyers in India (they pay INR + 18% GST); everyone else pays USD. Update regularly.
USD_INR=88

# RunPod: Pro training on Zebrain's GPUs
RUNPOD_API_KEY=
# RUNPOD_IMAGE=runpod/pytorch:2.4.0-py3.11-cuda12.4.1-devel-ubuntu22.04
# RUNPOD_CLOUD=SECURE

# Public address of this site: Kaggle and RunPod jobs reach the AI gateway here (not localhost)
PUBLIC_URL=https://your-domain.com

# Admin page /admin (comma-separated emails)
ADMIN_EMAILS=

# "We're back" emails (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Zebrain <hello@your-domain.com>

# Vercel Cron: back-online probe and the overdue-GPU sweep. openssl rand -hex 32
CRON_SECRET=
